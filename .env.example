# Copie este arquivo para .env.local e preencha os valores.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# E-mails autorizados a entrar, separados por vírgula
ALLOWED_EMAILS=

# Opcional: pesquisa na internet (https://tavily.com). Sem esta chave, o chat
# responde apenas com as anotações.
TAVILY_API_KEY=
